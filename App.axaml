<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FerrumKix.App"
             Name="FerrumKix"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#F08A1A"/>
                <ColorPaletteResources x:Key="Dark" Accent="#F08A1A"/>
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://FerrumKix/Styles/FerrumKixTheme.axaml"/>
    </Application.Styles>
</Application>

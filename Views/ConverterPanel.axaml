<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumKix.Controls"
             xmlns:local="clr-namespace:FerrumKix.Views"
             x:Class="FerrumKix.Views.ConverterPanel">
  <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource FP.Bg.Veil}">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="18,10,14,7">
      <Button Grid.Column="0" x:Name="BackButton" Classes="icon-btn back-navigation" Click="OnBackClick" ToolTip.Tip="Zurück zur Wiedergabeliste">
        <icons:SvgIcon Source="avares://FerrumKix/Assets/Icons/outline/chevron-left.svg" Width="17" Height="17"/>
      </Button>
      <Button Grid.Column="0" x:Name="CancelButton" Content="Abbrechen" Click="OnCancelClick" IsVisible="False"/>
      <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
        <TextBlock Text="Audio konvertieren" FontSize="{DynamicResource FP.Font.Title}" FontWeight="SemiBold"/>
      </StackPanel>
      <TextBlock Grid.Column="2" x:Name="CountText" Classes="secondary" VerticalAlignment="Center"/>
    </Grid>

    <Grid Grid.Row="1" RowDefinitions="*,Auto" Margin="18,0,18,12" RowSpacing="10">
      <Border BorderBrush="{DynamicResource FP.Border.Normal}" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
        <ListBox x:Name="QueueBox" ItemsSource="{Binding DisplayRows}" BorderThickness="0">
          <!-- Dieselbe Darstellung wie die Wiedergabeliste: Haekchen, Nummer und Titel, darunter
               die Angaben zur Datei. Die Klassen track-row und group-row stehen im Thema, damit
               beide Listen nicht auseinanderlaufen. Rechts steht statt der Spielzeit der Stand
               der Umwandlung. -->
          <ListBox.DataTemplates>
            <DataTemplate DataType="local:ConversionQueueGroupRow">
              <Border Classes="group-row" Padding="12,7,16,7">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="1" Text="{Binding Summary}" VerticalAlignment="Center"/>
                </Grid>
              </Border>
            </DataTemplate>
            <DataTemplate DataType="local:ConversionQueueRow">
              <Border Classes="track-row" Classes.playing="{Binding IsConverting}" Padding="12,5,16,5">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <CheckBox Grid.Column="0"
                            IsChecked="{Binding IsEnabled}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Titel umwandeln"/>
                  <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="{Binding NumberedTitle}"
                               TextTrimming="CharacterEllipsis"
                               FontSize="{DynamicResource FP.Font.ItemTitle}"/>
                    <TextBlock Text="{Binding Detail}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Status}" Classes="secondary" VerticalAlignment="Center"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.DataTemplates>
        </ListBox>
      </Border>

      <!-- Waehrend eines Laufs laesst sich hier nichts mehr aendern. Der Block verschwindet
           dann ganz und gibt seinen Platz der Liste: man sieht mehr davon, und die Liste rollt
           dem Titel nach, der gerade an der Reihe ist. -->
      <Border Grid.Row="1" x:Name="SettingsBox" Background="{DynamicResource FP.Bg.Panel}" BorderBrush="{DynamicResource FP.Border.Normal}" BorderThickness="1" CornerRadius="7" Padding="12">
        <StackPanel Spacing="10">
          <WrapPanel>
            <TextBlock Text="Zielformat" Classes="section-header" Width="108" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <RadioButton x:Name="Mp3Radio" GroupName="format" Content="MP3" IsChecked="True"/>
              <RadioButton x:Name="FlacRadio" GroupName="format" Content="FLAC"/>
              <RadioButton x:Name="OggRadio" GroupName="format" Content="Ogg"/>
            </StackPanel>
          </WrapPanel>
          <WrapPanel>
            <TextBlock Text="MP3-Qualität" Classes="section-header" Width="108" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <RadioButton x:Name="CbrRadio" GroupName="bitrate" Content="CBR" IsChecked="True"/>
              <RadioButton x:Name="VbrRadio" GroupName="bitrate" Content="VBR"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="14,0,0,0">
              <RadioButton x:Name="B128Radio" GroupName="rate" Content="128"/>
              <RadioButton x:Name="B192Radio" GroupName="rate" Content="192" IsChecked="True"/>
              <RadioButton x:Name="B256Radio" GroupName="rate" Content="256"/>
              <RadioButton x:Name="B320Radio" GroupName="rate" Content="320"/>
            </StackPanel>
          </WrapPanel>
          <Grid ColumnDefinitions="108,*,Auto" ColumnSpacing="8">
            <TextBlock Text="Ausgabe" Classes="section-header" VerticalAlignment="Center"/>
            <TextBox x:Name="FolderBox" Grid.Column="1" PlaceholderText="Zielordner auswählen" VerticalAlignment="Center"/>
            <Button Grid.Column="2" x:Name="ChooseFolderButton" Content="..." Click="OnChooseFolderClick" VerticalAlignment="Center" Padding="12,7"/>
          </Grid>
          <Grid ColumnDefinitions="108,*,Auto" ColumnSpacing="8">
            <ComboBox x:Name="ModeBox" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Left" MinWidth="260">
              <ComboBoxItem Content="Ein Ergebnis je Titel"/>
              <ComboBoxItem Content="Gesamtauswahl zusammenführen"/>
              <ComboBoxItem Content="Je Ordner zusammenführen"/>
            </ComboBox>
            <Button Grid.Column="2" x:Name="ConvertButton" Classes="primary-action" Content="Konvertierung starten" Click="OnConvertClick" VerticalAlignment="Center"/>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
    <!-- Die Statuszeile steht erst da, wenn sie etwas zu sagen hat. Eine leere Leiste am
         unteren Rand nahm der Liste nur Platz weg. -->
    <Border Grid.Row="2" x:Name="StatusBar" IsVisible="False" Background="{DynamicResource FP.Footer.Bg}" Padding="18,7">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock x:Name="StatusText" Classes="secondary" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <ProgressBar Grid.Column="1" x:Name="Progress" Width="130" Height="5" IsIndeterminate="True" IsVisible="False" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>

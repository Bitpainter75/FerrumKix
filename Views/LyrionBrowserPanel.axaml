<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumKix.Controls"
             xmlns:vm="clr-namespace:FerrumKix.ViewModels"
             x:Class="FerrumKix.Views.LyrionBrowserPanel">
    <UserControl.Styles>
        <!-- Die Cover sind Kacheln, keine Schaltflaechen: ihr Rand bleibt deshalb unsichtbar. -->
        <Style Selector="Button.lyrion-album">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="Button.lyrion-album:pointerover">
            <Setter Property="Opacity" Value="0.78"/>
        </Style>
        <Style Selector="Button.lyrion-album TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
        </Style>
        <Style Selector="Button.lyrion-album TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource FP.Text.Secondary}"/>
        </Style>
        <!-- Das Sternchen auf dem Cover: eine runde, dunkle Flaeche, damit es auch auf einem
             hellen Cover lesbar bleibt. -->
        <Style Selector="Button.fav-badge">
            <Setter Property="Background" Value="#99000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>
        <Style Selector="Button.fav-badge:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#CC000000"/>
        </Style>
        <!-- Die Meldungszeile des Favoritenabgleichs. Die FARBE sagt, ob noch etwas geschieht:
             im Akzent, solange der Lauf arbeitet, danach gedaempft wie jede andere Angabe. Genau
             diese Unterscheidung fehlte, solange der Abgleich sich die Statuszeile mit der
             Uebersicht teilte. -->
        <Style Selector="TextBlock#SyncStatus">
            <Setter Property="Foreground" Value="{DynamicResource FP.Text.Secondary}"/>
        </Style>
        <Style Selector="TextBlock#SyncStatus.sync-busy">
            <Setter Property="Foreground" Value="{DynamicResource FP.Accent}"/>
        </Style>
        <!-- Gleiche Flächen für Hover und Auswahl wie in der normalen Wiedergabeliste. -->
        <Style Selector="ListBoxItem.lyrion-track">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ListBoxItem.lyrion-track:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FP.Bg.Hover}"/>
        </Style>
        <Style Selector="ListBoxItem.lyrion-track:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FP.Sel.Bg}"/>
        </Style>
        <Style Selector="ListBoxItem.lyrion-track:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FP.Sel.Hover}"/>
        </Style>
        <Style Selector="ListBoxItem.lyrion-track.playing /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FP.Row.Playing}"/>
        </Style>
        <Style Selector="ListBoxItem.lyrion-track.playing:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FP.Row.PlayingHover}"/>
        </Style>
    </UserControl.Styles>
    <UserControl.Resources>
        <!-- Die Kachel eines Albums. Ihre Masse stehen HIER und nirgends sonst: UniformGridLayout
             misst das erste gebaute Element und teilt danach die Zeilen ein. -->
        <DataTemplate x:Key="LyrionAlbumTileTemplate" DataType="{x:Type vm:LyrionAlbumTile}">
            <Button Classes="lyrion-album" Width="172" Height="238" Padding="6"
                    Tag="{Binding}" Click="OnAlbumClick"
                    HorizontalContentAlignment="Left" VerticalContentAlignment="Top">
                <StackPanel Width="160" Spacing="6">
                    <!-- Der Rahmen steht auch ohne Bild: eine Kachel, deren Cover noch unterwegs
                         ist, darf die Zeile nicht kuerzer machen. -->
                    <Border Width="160" Height="160" CornerRadius="5" ClipToBounds="True"
                            Background="#22FFFFFF">
                        <Panel>
                            <icons:SvgIcon Source="avares://FerrumKix/Assets/Icons/outline/music.svg"
                                           Width="36" Height="36"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IconBrush="{DynamicResource FP.Text.Muted}"/>
                            <Image Source="{Binding Cover}" Width="160" Height="160"
                                   Stretch="UniformToFill"/>
                            <!-- Der Favoritenstern liegt AUF dem Cover und ist selbst eine
                                 Schaltflaeche. Sein Klick darf die Kachel nicht mit oeffnen;
                                 dafuer sorgt der Behandler, siehe OnFavoriteBadgeClick. -->
                            <Button Classes="fav-badge" Width="28" Height="28" Padding="0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,5,5,0" IsVisible="{Binding CanFavorite}"
                                    Tag="{Binding}" Click="OnFavoriteBadgeClick"
                                    ToolTip.Tip="Album als Favorit merken">
                                <Panel>
                                    <icons:SvgIcon Source="avares://FerrumKix/Assets/Icons/outline/star.svg"
                                                   Width="16" Height="16" IsVisible="{Binding !IsFavorite}"
                                                   IconBrush="#F0FFFFFF"/>
                                    <icons:SvgIcon Source="avares://FerrumKix/Assets/Icons/outline/star-filled.svg"
                                                   Width="16" Height="16" IsVisible="{Binding IsFavorite}"
                                                   IconBrush="{DynamicResource FP.Accent}"/>
                                </Panel>
                            </Button>
                        </Panel>
                    </Border>
                    <TextBlock Text="{Binding Title}" MinHeight="18" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Artist}" MinHeight="17" Classes="muted"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,Auto,*"
          Background="{DynamicResource FP.Bg.Veil}"
          Margin="18,10,10,10">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <Button Classes="icon-btn back-navigation" Click="OnBackClick" ToolTip.Tip="Zurück zur Wiedergabeliste">
                <icons:SvgIcon Source="avares://FerrumKix/Assets/Icons/outline/chevron-left.svg" Width="17" Height="17"/>
            </Button>
            <TextBlock x:Name="PageTitle" Grid.Column="1" Text="Lyrion Media Server"
                       FontSize="{DynamicResource FP.Font.Heading}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <Button Classes="icon-btn" Click="OnJumpToCurrentTrackClick" ToolTip.Tip="Zum aktuellen Titel springen">
                    <icons:SvgIcon Source="avares://FerrumKix/Assets/Icons/outline/target.svg" Width="16" Height="16"/>
                </Button>
                <Button x:Name="SyncButton" Classes="icon-btn" Click="OnSyncClick"
                        ToolTip.Tip="Favoriten in den Zielordner abgleichen">
                    <icons:SvgIcon Source="avares://FerrumKix/Assets/Icons/outline/download.svg" Width="16" Height="16"/>
                </Button>
                <Button Classes="icon-btn" Click="OnClearAllFavoritesClick"
                        ToolTip.Tip="Alle Album-Favoriten löschen">
                    <icons:SvgIcon Source="avares://FerrumKix/Assets/Icons/outline/trash-x.svg" Width="16" Height="16"/>
                </Button>
                <Button x:Name="ReloadButton" Classes="icon-btn" Click="OnReloadClick" ToolTip.Tip="Bibliothek aktualisieren">
                    <icons:SvgIcon Source="avares://FerrumKix/Assets/Icons/outline/repeat.svg" Width="16" Height="16"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Suche, Reihenfolge und der Favoritenfilter in EINER Zeile. Nur die Suche geht an den
             Server; Reihenfolge und Filter arbeiten auf der schon geholten Liste. -->
        <Grid Grid.Row="1" Margin="0,14,0,10" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
            <!-- Wo gespielt wird, ganz links: es ist keine Einrichtung, sondern eine Entscheidung,
                 die man beim Hoeren trifft - und sie gilt fuer alles, was rechts davon steht. -->
            <ComboBox x:Name="TargetBox" MinWidth="168" VerticalAlignment="Stretch"
                      SelectionChanged="OnPlaybackTargetChanged"
                      ToolTip.Tip="Wo die Wiedergabe läuft"/>
            <!-- Das Kreuz liegt IM Feld, rechts innen: die Suche ist hier nicht an den Bauplan
                 gebunden, deshalb setzt der Behandler seine Sichtbarkeit (OnSearchTextChanged).
                 Gleiche Geste wie in FerrumPix, nur ohne Bindung. -->
            <Panel Grid.Column="1">
                <!-- Rechts Platz fuer das Kreuz: die Vorgabe des Themes ist 10,6, und ohne die
                     breitere rechte Seite liefe ein langer Begriff darunter durch. -->
                <TextBox x:Name="SearchBox" PlaceholderText="Alben durchsuchen"
                         Padding="10,6,32,6" TextChanged="OnSearchTextChanged"/>
                <Button x:Name="SearchClearButton" Classes="icon-btn" IsVisible="False"
                        Width="22" Height="22" Margin="0,0,6,0"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="OnClearSearchClick" ToolTip.Tip="Suche zurücksetzen">
                    <icons:SvgIcon Source="avares://FerrumKix/Assets/Icons/outline/x.svg"
                                   Width="12" Height="12" Opacity="0.75"/>
                </Button>
            </Panel>
            <ComboBox x:Name="SortBox" Grid.Column="2" MinWidth="184" VerticalAlignment="Stretch"
                      SelectionChanged="OnSortChanged"/>
            <Button x:Name="SortDirectionButton" Grid.Column="3" Classes="icon-btn"
                    Click="OnSortDirectionClick" ToolTip.Tip="Reihenfolge umkehren">
                <icons:SvgIcon x:Name="SortDirectionIcon" Width="16" Height="16"
                               Source="avares://FerrumKix/Assets/Icons/outline/sort-ascending.svg"/>
            </Button>
            <Button x:Name="FavoriteFilterButton" Grid.Column="4" Classes="icon-btn"
                    Click="OnFavoriteFilterClick" ToolTip.Tip="Nur Favoriten zeigen">
                <icons:SvgIcon Width="16" Height="16"
                               Source="avares://FerrumKix/Assets/Icons/outline/star.svg"/>
            </Button>
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="Auto,Auto,*">
            <TextBlock x:Name="Status" Classes="muted" Text="Lyrion Media Server wird geladen …" Margin="2,0,0,8"/>
            <!-- Der Favoritenabgleich bekommt eine EIGENE Zeile. Teilte er sie sich mit der
                 Statuszeile darueber, loeschte jeder Handgriff in der Uebersicht - umsortieren,
                 filtern, ein Album oeffnen - seinen Fortschritt weg, und nach dem Lauf waere das
                 Ergebnis beim naechsten Neuaufbau der Liste verschwunden. Sie steht nur da, wenn
                 es etwas zu sagen gibt, und ihr Text kommt ausschliesslich aus dem Dienst
                 (LyrionFavoriteSyncService.Status), nicht aus diesem Panel. -->
            <Border x:Name="SyncStatusBox" Grid.Row="1" IsVisible="False"
                    Background="{DynamicResource FP.Bg.Elevated}" CornerRadius="6"
                    Padding="10,6" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock x:Name="SyncStatus" Classes="no-translate"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <!-- Steht nur da, wenn der letzte Lauf Favoriten ohne passendes Album
                         gefunden hat. Der Klick fragt erst nach und zeigt dabei, um welche
                         Eintraege es geht - geloescht wird beim Server, das ist nicht
                         zurueckzunehmen. -->
                    <Button x:Name="SyncCleanupButton" Grid.Column="1" Classes="icon-btn"
                            Width="22" Height="22" IsVisible="False"
                            Click="OnRemoveUnresolvedClick"
                            ToolTip.Tip="Favoriten ohne passendes Album aus den Favoriten nehmen">
                        <icons:SvgIcon Source="avares://FerrumKix/Assets/Icons/outline/trash.svg"
                                       Width="13" Height="13"/>
                    </Button>
                    <Button x:Name="SyncDismissButton" Grid.Column="2" Classes="icon-btn"
                            Width="22" Height="22" Click="OnSyncDismissClick"
                            ToolTip.Tip="Meldung ausblenden">
                        <icons:SvgIcon Source="avares://FerrumKix/Assets/Icons/outline/x.svg"
                                       Width="12" Height="12"/>
                    </Button>
                </Grid>
            </Border>
            <Grid Grid.Row="2">
                <!-- Die Alben und die Titel eines Albums haben je einen eigenen Rollbereich: der
                     Repeater bekommt sein Sichtfenster vom ScrollViewer, in dem er steckt, und
                     kann sich zwei Ansichten nicht mit einer Liste teilen. -->
                <ScrollViewer x:Name="AlbumScroll"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              ScrollChanged="OnAlbumScrollChanged">
                    <!-- MinItemWidth/MinItemHeight werden bewusst nicht gesetzt: das Layout nimmt
                         sie unveraendert als Mass und vergleicht sie nicht mit der Kachel. Ohne
                         Angabe misst es das erste gebaute Element und trifft damit immer. -->
                    <ItemsRepeater x:Name="Albums"
                                   VerticalAlignment="Top"
                                   ElementPrepared="OnAlbumTilePrepared"
                                   ElementClearing="OnAlbumTileClearing"
                                   ItemTemplate="{StaticResource LyrionAlbumTileTemplate}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout Orientation="Horizontal"
                                               ItemsStretch="None"
                                               ItemsJustification="Start"/>
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </ScrollViewer>
                <ScrollViewer x:Name="TrackScroll" IsVisible="False"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="Tracks" Background="Transparent" BorderThickness="0"
                             SelectionMode="Single" DoubleTapped="OnTracksDoubleTapped"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

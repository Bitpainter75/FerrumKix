<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FerrumPlay.Views.ConversionDialog"
        Title="Audio konvertieren" Width="540" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="#20242b">
  <StackPanel Margin="26" Spacing="16">
    <TextBlock x:Name="SelectionText" FontSize="18" FontWeight="SemiBold"/>
    <TextBlock Text="Die Originaldateien bleiben unverändert. FFmpeg wird vom System verwendet."
               Foreground="#c9c4b6" TextWrapping="Wrap"/>
    <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="12">
      <TextBlock Grid.Row="0" Text="Zielformat" VerticalAlignment="Center"/>
      <ComboBox x:Name="FormatBox" Grid.Row="0" SelectedIndex="0">
        <ComboBoxItem Content="MP3"/><ComboBoxItem Content="FLAC"/><ComboBoxItem Content="Ogg Vorbis"/>
      </ComboBox>
      <TextBlock Grid.Row="1" Text="Bitrate / Qualität" VerticalAlignment="Center"/>
      <ComboBox x:Name="BitrateBox" Grid.Row="1" SelectedIndex="1">
        <ComboBoxItem Content="128 kbit/s"/><ComboBoxItem Content="192 kbit/s"/><ComboBoxItem Content="256 kbit/s"/><ComboBoxItem Content="320 kbit/s"/>
      </ComboBox>
      <CheckBox x:Name="VbrBox" Grid.Row="2" Grid.Column="1" Content="Variable Bitrate (VBR, nur MP3)"/>
    </Grid>
    <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto" RowSpacing="12" ColumnSpacing="12">
      <TextBlock Grid.Row="0" Text="Ausgabeform" VerticalAlignment="Center"/>
      <ComboBox x:Name="ModeBox" Grid.Row="0" SelectedIndex="0">
        <ComboBoxItem Content="Ein Ergebnis je Titel"/>
        <ComboBoxItem Content="Gesamtauswahl zusammenführen"/>
        <ComboBoxItem Content="Gesamtauswahl mit Kapiteldatei"/>
        <ComboBoxItem Content="Je Ordner zusammenführen"/>
        <ComboBoxItem Content="Je Ordner mit Kapiteldatei"/>
      </ComboBox>
      <CheckBox x:Name="CueBox" Grid.Row="1" Grid.Column="1" Content="Vorhandene CUE-Datei in einzelne Titel aufteilen"/>
    </Grid>
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <TextBox x:Name="FolderBox" PlaceholderText="Zielordner auswählen" IsReadOnly="True"/>
      <Button Content="Ordner…" Click="OnChooseFolderClick"/>
    </Grid>
    <ProgressBar x:Name="Progress" IsIndeterminate="True" IsVisible="False" Height="5"/>
    <TextBlock x:Name="StatusText" Foreground="#c9c4b6" TextWrapping="Wrap"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button x:Name="CancelButton" Content="Abbrechen" Click="OnCancelClick"/>
      <Button x:Name="ConvertButton" Content="Konvertieren" Click="OnConvertClick"/>
    </StackPanel>
  </StackPanel>
</Window>

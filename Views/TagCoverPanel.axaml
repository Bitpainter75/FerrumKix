<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumKix.Controls"
             xmlns:views="clr-namespace:FerrumKix.Views"
             x:Class="FerrumKix.Views.TagCoverPanel"
             DragDrop.AllowDrop="True"
             Background="Transparent">
    <UserControl.Styles>
        <!-- Die Einladung zum Ablegen haengt an der GANZEN Spalte und nicht am Bildrahmen:
             abgelegt werden darf ueberall hier, siehe PlayerView.TagCoverTargetAt.

             Zwei Ausloeser, weil keiner allein reicht. ":pointerover" greift beim blossen
             Ueberfahren mit der Maus und weist das Ziel aus, bevor ueberhaupt gezogen wird.
             Waehrend eines laufenden Ziehens bleibt der Zeiger dagegen beim Ausgangsfenster,
             und diese Pseudoklasse aendert sich nicht mehr - dafuer setzt SetDropActive die
             Klasse "drop-active".

             Die Ruhewerte stehen MIT IN DEN STILVORLAGEN und nicht am Element: ein dort gesetzter
             Wert schlaegt in Avalonia jede Stilvorlage, und der Akzentrahmen kam deshalb nie zum
             Vorschein. Dieselbe Aufteilung wie bei Border.track-row in PlayerView.axaml. -->
        <Style Selector="Border#CoverArea">
            <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="views|TagCoverPanel.drop-active Border#CoverArea, views|TagCoverPanel:pointerover Border#CoverArea">
            <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
            <Setter Property="BorderThickness" Value="3"/>
        </Style>
        <!-- Ein Rahmen allein war zu wenig: liegt bereits ein Cover im Feld, fuellt es die
             Flaeche, und drei Bildpunkte Rand daneben gehen im Bild unter. Die Einladung legt
             sich deshalb als eigene Schicht UEBER das Bild.

             NUR waehrend eines Ziehens, nicht schon beim Ueberfahren: sie verdeckt das Cover,
             und das waere bei jeder Mausbewegung ueber die Spalte hinweg im Weg. Das blosse
             Ueberfahren bekommt den Rahmen und den hervorgehobenen Hinweis, das Ziehen die
             ganze Schicht - je naeher am Ablegen, desto deutlicher. -->
        <Style Selector="Border#DropOverlay">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="views|TagCoverPanel.drop-active Border#DropOverlay">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="views|TagCoverPanel.drop-active TextBlock#DropHint, views|TagCoverPanel:pointerover TextBlock#DropHint">
            <Setter Property="Foreground" Value="{DynamicResource FP.Accent}"/>
        </Style>
    </UserControl.Styles>
    <!-- Die Spalte waehrend des Taggens. Sie liegt an der Stelle der laufenden Wiedergabe, zeigt
         aber ausschliesslich das, was getaggt wird: solange der Tag-Bereich offen ist, hat die
         Wiedergabe hier nichts verloren. -->
    <StackPanel Spacing="16" VerticalAlignment="Top">
        <TextBlock Text="Cover für das Taggen" Classes="muted" TextAlignment="Center"/>
        <Border x:Name="CoverArea" CornerRadius="6"
                ClipToBounds="True"
                Width="{Binding CoverSize}"
                Height="{Binding CoverSize}"
                Background="#22FFFFFF">
            <Panel>
                <icons:SvgIcon Source="avares://FerrumKix/Assets/Icons/outline/music.svg"
                               Width="56" Height="56"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IconBrush="{DynamicResource FP.Text.Muted}"/>
                <Image x:Name="CoverImage" Stretch="UniformToFill"/>
                <!-- Verdeckt das Bild fast ganz, damit Zeichen und Text darauf lesbar bleiben -
                     ein helles Cover darunter frisst sonst beides. Nimmt selbst keine Zeigertreffer
                     entgegen: sonst verdeckte es die Flaeche, auf die es gerade hinweist. -->
                <Border x:Name="DropOverlay"
                        Background="#E60B0E11"
                        IsHitTestVisible="False">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Margin="12">
                        <icons:SvgIcon Source="avares://FerrumKix/Assets/Icons/outline/download.svg"
                                       Width="44" Height="44"
                                       HorizontalAlignment="Center"
                                       IconBrush="{DynamicResource FP.Accent}"/>
                        <TextBlock Text="Bild hier ablegen"
                                   Foreground="{DynamicResource FP.Accent}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Panel>
        </Border>
        <StackPanel Spacing="4">
            <TextBlock x:Name="AlbumText"
                       FontSize="{DynamicResource FP.Font.Heading}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"/>
            <TextBlock x:Name="ArtistText"
                       Classes="secondary"
                       FontSize="{DynamicResource FP.Font.Subtitle}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"/>
            <TextBlock x:Name="CountText"
                       Classes="secondary"
                       TextAlignment="Center"/>
            <!-- Das Mass des Bildes, das gerade im Rahmen steht: "1400 × 1400" und bei einem
                 abgelegten zusaetzlich seine Dateigroesse. Reine Zahlen, deshalb ohne Ubersetzung. -->
            <TextBlock x:Name="SizeText"
                       Classes="muted"
                       TextAlignment="Center"/>
        </StackPanel>
        <StackPanel Spacing="8" Margin="0,4,0,0">
            <!-- Der Knopf ist der VERLAESSLICHE Weg und steht deshalb zuerst. Das Ziehen bleibt
                 daneben stehen, es ist der bequemere - nur kommt unter XWayland nicht die
                 gezogene Datei an, sondern der Inhalt der Zwischenablage. Das liegt an der
                 X11-Anbindung von Avalonia und nicht an dieser Anwendung; der Auswahldialog geht
                 ueber IStorageProvider und ist davon nicht betroffen. -->
            <Button Classes="ghost"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Click="OnChooseCoverClick"
                    Content="Cover wählen …"/>
            <TextBlock x:Name="DropHint"
                       Text="oder Cover hierher ziehen"
                       Classes="muted"
                       TextWrapping="Wrap"
                       TextAlignment="Center"/>
        </StackPanel>
    </StackPanel>
</UserControl>

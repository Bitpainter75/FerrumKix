<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FerrumPlay.Controls"
             x:Class="FerrumPlay.Views.SettingsView"
             Classes="settings-view"
             Background="{DynamicResource FP.Bg.Root}">

    <UserControl.Styles>
        <!-- Ein Eintrag der Bereichsliste. Derselbe Zuschnitt wie in FerrumPix: Symbol, Text,
             ueber die ganze Breite, linksbuendig. -->
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>
        <Style Selector="TextBlock.setting-title">
            <Setter Property="FontSize" Value="{DynamicResource FP.Font.ItemTitle}"/>
        </Style>
        <!-- LINKSBUENDIG, nicht gestreckt: ein gestrecktes Element, das an seiner MaxWidth
             haengen bleibt, setzt Avalonia MITTIG in den uebrigen Platz. Die Hilfetexte standen
             dadurch je nach Fensterbreite eingerueckt unter ihrer Ueberschrift. -->
        <Style Selector="TextBlock.setting-note">
            <Setter Property="Foreground" Value="{DynamicResource FP.Text.Muted}"/>
            <Setter Property="FontSize" Value="{DynamicResource FP.Font.Small}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxWidth" Value="520"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="TextBlock.group-caption">
            <Setter Property="FontSize" Value="{DynamicResource FP.Font.Title}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="250,*">

        <!-- Die Bereichsliste kann laenger werden als das Fenster hoch ist. Der Rollbereich zeigt
             seine Leiste nur, wenn er gebraucht wird; die Ueberschrift bleibt ausserhalb stehen,
             damit sie beim Rollen nicht verschwindet. -->
        <Border Grid.Column="0" Classes="sidebar" Padding="12,16,10,16">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="Einstellungen"
                           FontSize="{DynamicResource FP.Font.Title}"
                           FontWeight="SemiBold" Margin="6,0,0,10"/>

                <Button DockPanel.Dock="Bottom" Classes="ghost nav"
                        Margin="0,10,0,0"
                        Command="{Binding ClosePanelCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:SvgIcon Source="avares://FerrumPlay/Assets/Icons/outline/chevron-left.svg"
                                       Width="16" Height="16"/>
                        <TextBlock Text="Zurück zur Wiedergabe"/>
                    </StackPanel>
                </Button>

                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <Button Classes="ghost nav" Tag="AboutSection" Click="OnSectionNavClick">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <icons:SvgIcon Source="avares://FerrumPlay/Assets/Icons/outline/info-circle.svg"
                                               Width="16" Height="16"/>
                                <TextBlock Text="Über FerrumPlay"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="ghost nav" Tag="PlaybackSection" Click="OnSectionNavClick">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <icons:SvgIcon Source="avares://FerrumPlay/Assets/Icons/outline/player-play.svg"
                                               Width="16" Height="16"/>
                                <TextBlock Text="Wiedergabe"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="ghost nav" Tag="AppearanceSection" Click="OnSectionNavClick">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <icons:SvgIcon Source="avares://FerrumPlay/Assets/Icons/outline/adjustments-horizontal.svg"
                                               Width="16" Height="16"/>
                                <TextBlock Text="Darstellung"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="ghost nav" Tag="TaggingSection" Click="OnSectionNavClick"><StackPanel Orientation="Horizontal" Spacing="10"><icons:SvgIcon Source="avares://FerrumPlay/Assets/Icons/outline/disc.svg" Width="16" Height="16"/><TextBlock Text="MP3-Tags"/></StackPanel></Button>
                        <Button Classes="ghost nav" Tag="ConverterSection" Click="OnSectionNavClick"><StackPanel Orientation="Horizontal" Spacing="10"><icons:SvgIcon Source="avares://FerrumPlay/Assets/Icons/outline/arrows-sort.svg" Width="16" Height="16"/><TextBlock Text="Audio-Konverter"/></StackPanel></Button>
                        <Button Classes="ghost nav" Tag="LyrionSection" Click="OnSectionNavClick"><StackPanel Orientation="Horizontal" Spacing="10"><icons:SvgIcon Source="avares://FerrumPlay/Assets/Icons/outline/music.svg" Width="16" Height="16"/><TextBlock Text="Lyrion Media Server"/></StackPanel></Button>
                        <Button Classes="ghost nav" Tag="DiagnosticsSection" Click="OnSectionNavClick"><StackPanel Orientation="Horizontal" Spacing="10"><icons:SvgIcon Source="avares://FerrumPlay/Assets/Icons/outline/alert-triangle.svg" Width="16" Height="16"/><TextBlock Text="Fehlersuche"/></StackPanel></Button>
                        <Button Classes="ghost nav" Tag="TechnologySection" Click="OnSectionNavClick"><StackPanel Orientation="Horizontal" Spacing="10"><icons:SvgIcon Source="avares://FerrumPlay/Assets/Icons/outline/info-circle.svg" Width="16" Height="16"/><TextBlock Text="Technologie &amp; Lizenzen"/></StackPanel></Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" x:Name="SectionScroller" Padding="26,20,26,26"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="18" MaxWidth="820" HorizontalAlignment="Left">

                <!-- Der Abschnitt ueber die Anwendung steht OBEN: Name, Fassung und die Frage, ob
                     libmpv gefunden wurde, sind das Erste, was man beim Oeffnen sehen soll. -->
                <Border x:Name="AboutSection" Classes="section">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="avares://FerrumPlay/Assets/FerrumPlay_Icon_256.png"
                                   Height="46" Stretch="Uniform" HorizontalAlignment="Left"/>
                            <Image Source="avares://FerrumPlay/Assets/FerrumPlay_TopBar.png"
                                   Margin="10 4 0 0" Height="46" Stretch="Uniform" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto"
                              ColumnSpacing="12" RowSpacing="8">
                            <TextBlock Grid.Row="0" Text="Version" Foreground="{DynamicResource FP.Text.Muted}"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{Binding DisplayVersion}" VerticalAlignment="Center"/>
                                <!-- Der Hinweis erscheint nur, wenn die veroeffentlichte Nummer von der
                                     laufenden abweicht; ein Klick fuehrt zur Veroeffentlichungsseite. -->
                                <Button Classes="ghost" Padding="10,4" VerticalAlignment="Center"
                                        IsVisible="{Binding IsUpdateAvailable}"
                                        Click="OnReleasePageClick"
                                        ToolTip.Tip="Veröffentlichte Fassung herunterladen">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <icons:SvgIcon Source="avares://FerrumPlay/Assets/Icons/outline/external-link.svg"
                                                       Width="14" Height="14" IconBrush="{DynamicResource FP.Accent}"/>
                                        <TextBlock Text="Aktualisierung verfügbar:" Foreground="{DynamicResource FP.Accent}"/>
                                        <TextBlock Text="{Binding AvailableVersion}" Foreground="{DynamicResource FP.Accent}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="Einstellungen" Foreground="{DynamicResource FP.Text.Muted}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SettingsFilePath}"
                                       TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="2" Text="Wiedergabeliste" Foreground="{DynamicResource FP.Text.Muted}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PlaylistFilePath}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="PlaybackSection" Classes="section">
                    <StackPanel Spacing="18">
                        <TextBlock Text="Wiedergabe" Classes="group-caption"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Lückenlose Wiedergabe" Classes="setting-title"/>
                                <TextBlock Classes="setting-note"
                                           Text="Die Stille am Dateiende wird übersprungen, damit ein durchgehend gemischtes Album ohne Bruch läuft. Wirkt ab dem nächsten Titel."/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          OnContent="" OffContent=""
                                          IsChecked="{Binding IsGaplessEnabled, Mode=TwoWay}"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Lautstärke angleichen (ReplayGain)" Classes="setting-title"/>
                                <TextBlock Classes="setting-note"
                                           Text="Gleicht die Lautstärke nach den ReplayGain-Angaben in den Dateien an. „Nach Album“ lässt die leisen und lauten Stellen innerhalb eines Albums stehen, „Automatisch“ nimmt bei zufälliger Reihenfolge die Angabe des Titels. Titel ohne diese Angaben spielen unverändert."/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" MinWidth="200" VerticalAlignment="Center"
                                      ItemsSource="{Binding ReplayGainChoices}"
                                      SelectedItem="{Binding SelectedReplayGain, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <!-- Die Vorverstaerkung steht nur da, wenn angeglichen wird: ohne Angleichung
                             bewirkt sie nichts, und ein Regler ohne Wirkung verwirrt. -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20" IsVisible="{Binding IsReplayGainEnabled}">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Vorverstärkung" Classes="setting-title"/>
                                <TextBlock Classes="setting-note"
                                           Text="Hebt oder senkt alle angeglichenen Titel um denselben Betrag. ReplayGain zielt eher leise; ein paar Dezibel mehr gleichen das aus. Übersteuern verhindert mpv von sich aus."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                        VerticalAlignment="Center">
                                <icons:RoundSlider Width="220" Minimum="-15" Maximum="15"
                                                   Step="0.5" WheelIncrement="0.5" DefaultValue="0"
                                                   VerticalAlignment="Center"
                                                   ToolTip.Tip="Doppelklick setzt auf 0 dB zurück"
                                                   Value="{Binding ReplayGainPreamp, Mode=TwoWay}"/>
                                <TextBlock Text="{Binding ReplayGainPreampText}"
                                           VerticalAlignment="Center" MinWidth="64"
                                           Foreground="{DynamicResource FP.Text.Secondary}"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Beim Start fortsetzen" Classes="setting-title"/>
                                <TextBlock Classes="setting-note"
                                           Text="FerrumPlay nimmt den zuletzt gespielten Titel an der Stelle wieder auf, an der er unterbrochen wurde. Ausgeschaltet wird der Titel nur ausgewählt und nicht gestartet."/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          OnContent="" OffContent=""
                                          IsChecked="{Binding IsResumeOnStart, Mode=TwoWay}"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Tonausgabe" Classes="setting-title"/>
                                <TextBlock Classes="setting-note"
                                           Text="Der Ton läuft über libmpv und damit über das Ausgabegerät des Systems."/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       Text="{Binding AudioBackendText}"
                                       Foreground="{DynamicResource FP.Text.Secondary}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="AppearanceSection" Classes="section">
                    <StackPanel Spacing="18">
                        <TextBlock Text="Darstellung" Classes="group-caption"/>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Sprache" Classes="setting-title"/>
                                <TextBlock Classes="setting-note"
                                           Text="Verwendet standardmäßig die Systemsprache; falls nicht unterstützt, Englisch."/>
                            </StackPanel>
                            <!-- Die Namen stehen in ihrer eigenen Sprache, wie in FerrumPix: wer die
                                 Oberflaeche in einer Sprache sieht, die er nicht versteht, findet
                                 "Deutsch" wieder. -->
                            <ComboBox Grid.Column="1" MinWidth="200" VerticalAlignment="Center"
                                      ItemsSource="{Binding LanguageChoices}"
                                      SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Akzentfarbe" Classes="setting-title"/>
                            <TextBlock Classes="setting-note"
                                       Text="Die Farbe der Hervorhebungen: Fortschritt, Wiedergabeknopf, Lautstärkeregler und die Zeile des laufenden Titels wechseln mit."/>
                            <ItemsControl ItemsSource="{Binding AccentChoices}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Classes="swatch"
                                                Classes.active="{Binding IsActive}"
                                                Margin="0,0,8,0"
                                                Background="{Binding Swatch}"
                                                Command="{Binding $parent[ItemsControl].DataContext.SetAccentColorCommand}"
                                                CommandParameter="{Binding HexColor}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Schriftgröße" Classes="setting-title"/>
                            <TextBlock Classes="setting-note"
                                       Text="Verschiebt alle Texte der Oberfläche um denselben Betrag. Die Zeichen in den Fensterknöpfen bleiben, wie sie sind: sie sind Grafik in fester Knopfgröße."/>
                            <ItemsControl ItemsSource="{Binding FontSizeChoices}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Die Probe steht in GENAU DER Groesse, die der Knopf
                                             einstellt. Man soll sehen, was man waehlt. -->
                                        <Button Classes="font-step"
                                                Classes.active="{Binding IsActive}"
                                                Margin="0,0,6,0"
                                                ToolTip.Tip="{Binding Tip}"
                                                Command="{Binding $parent[ItemsControl].DataContext.SetFontSizeCommand}"
                                                CommandParameter="{Binding Offset}">
                                            <TextBlock Text="Aa" FontSize="{Binding SampleSize}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="8" IsVisible="{Binding AreScreenScalesVisible}">
                            <TextBlock Text="Vergrößerung der Anwendung" Classes="setting-title"/>
                            <TextBlock Classes="setting-note"
                                       Text="Ein eigener Faktor je Bildschirm, für den Fall, dass die Anwendung dort zu klein steht. Gilt sofort."/>
                            <ItemsControl ItemsSource="{Binding ScreenScales}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20" Margin="0,0,0,10">
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ScreenName}"/>
                                                <TextBlock Text="{Binding Description}" Classes="muted"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                                        VerticalAlignment="Center">
                                                <icons:RoundSlider Width="220" Minimum="1" Maximum="2.5"
                                                                   Step="0.05" DefaultValue="1"
                                                                   VerticalAlignment="Center"
                                                                   ToolTip.Tip="Doppelklick setzt auf 100 Prozent zurück"
                                                                   ValueCommitted="OnScreenScaleCommitted"
                                                                   Value="{Binding Scale, Mode=TwoWay}"/>
                                                <TextBlock Text="{Binding ScaleText}"
                                                           VerticalAlignment="Center" MinWidth="86"
                                                           Foreground="{DynamicResource FP.Text.Secondary}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Unscharfes Titelbild im Hintergrund" Classes="setting-title"/>
                                <TextBlock Classes="setting-note"
                                           Text="Das Titelbild füllt weichgezeichnet das Fenster. Ausgeschaltet bleibt eine ruhige dunkle Fläche stehen."/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          OnContent="" OffContent=""
                                          IsChecked="{Binding IsBlurredBackgroundVisible, Mode=TwoWay}"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Breite der Coverspalte" Classes="setting-title"/>
                                <TextBlock Classes="setting-note"
                                           Text="Lässt sich auch mit der Trennlinie neben dem Titelbild ziehen."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                        VerticalAlignment="Center">
                                <icons:RoundSlider Width="220" Minimum="220" Maximum="520"
                                                   Step="1" WheelIncrement="10" DefaultValue="300"
                                                   VerticalAlignment="Center"
                                                   ToolTip.Tip="Doppelklick setzt auf 300 zurück"
                                                   Value="{Binding SidePanelWidth, Mode=TwoWay}"/>
                                <TextBlock Text="{Binding SidePanelWidth, StringFormat={}{0:0}}"
                                           VerticalAlignment="Center" MinWidth="34"
                                           Foreground="{DynamicResource FP.Text.Secondary}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="TaggingSection" Classes="section">
                    <StackPanel Spacing="18">
                        <TextBlock Text="MP3-Tags" Classes="group-caption"/>
                        <StackPanel Spacing="5"><TextBlock Text="Titelbild: Kantenlänge" Classes="setting-title"/><Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><NumericUpDown Classes="combo-like" Width="148" Minimum="64" Maximum="3000" Increment="100" FormatString="0" Value="{Binding TagCoverSize, Mode=TwoWay}"/><TextBlock Grid.Column="1" Text="Auf dieses Maß wird ein Titelbild beim Speichern gebracht. Es gilt auch für das Bild, das die Audio-CD-Erkennung holt." Classes="setting-note" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid></StackPanel>
                        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="3"><TextBlock Text="Album Artist an Artist angleichen" Classes="setting-title"/><TextBlock Text="Beim Speichern übernimmt Album Artist automatisch den Artist-Wert." Classes="setting-note"/></StackPanel><ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsChecked="{Binding TagAlbumArtistFollowsArtist, Mode=TwoWay}"/></Grid>
                        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="3"><TextBlock Text="Album-Sortierung an Jahr angleichen" Classes="setting-title"/><TextBlock Text="Beim Speichern übernimmt Album-Sortierung automatisch den Jahreswert." Classes="setting-note"/></StackPanel><ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsChecked="{Binding TagAlbumSortFollowsYear, Mode=TwoWay}"/></Grid>
                        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="3"><TextBlock Text="Übrige Tags beim Speichern entfernen" Classes="setting-title"/><TextBlock Text="Belässt nur die vorgesehenen ID3v2-Felder und entfernt ID3v1, APEv2 sowie weitere Kennzeichen." Classes="setting-note"/></StackPanel><ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsChecked="{Binding TagRemoveOtherFields, Mode=TwoWay}"/></Grid>
                        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="3"><TextBlock Text="Tracknummer mit Nullen auffüllen" Classes="setting-title"/><TextBlock Text="Gilt für den Tag, die Eingabefelder im Tag-Editor und den Dateinamen: die Stellenzahl richtet sich nach der Titelzahl des Albums, z. B. 01 bei 10 Titeln oder 001 bei 100." Classes="setting-note"/></StackPanel><ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsChecked="{Binding TagPadTrackNumberToAlbumLength, Mode=TwoWay}"/></Grid>
                        <StackPanel Spacing="5"><TextBlock Text="Dateiname beim Taggen" Classes="setting-title"/><TextBlock Text="Muster für die Umbenennung: %artist%, %albumartist%, %album%, %title%, %track%, %totaltracks%, %disc%, %year%, %genre%. Führende Nullen bei %track% regelt die Einstellung darüber. Die Endung .mp3 kommt von selbst dazu; ein leeres Feld stellt die Vorgabe wieder her." Classes="setting-note"/><TextBox PlaceholderText="%artist% - %track% - %title%" Text="{Binding TagFileNamePattern, Mode=TwoWay}"/><TextBlock Text="{Binding TagFileNamePatternPreview, StringFormat='Beispiel: {0}'}" Classes="setting-note"/></StackPanel>
                        <StackPanel Spacing="5"><TextBlock Text="Genre-Vorgaben" Classes="setting-title"/><TextBlock Text="Ein Genre je Zeile. Diese Liste erscheint als Auswahl beim MP3-Tagging; ein eigener Wert bleibt dort weiterhin möglich." Classes="setting-note"/><TextBox AcceptsReturn="True" MinHeight="100" Text="{Binding TagGenresText, Mode=TwoWay}"/></StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="ConverterSection" Classes="section">
                    <StackPanel Spacing="18"><TextBlock Text="Audio-Konverter" Classes="group-caption"/>
                        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Standardformat" Classes="setting-title"/><ComboBox Grid.Column="1" Width="170" SelectedIndex="{Binding ConverterDefaultFormat, Mode=TwoWay}"><ComboBoxItem Content="MP3"/><ComboBoxItem Content="FLAC"/><ComboBoxItem Content="Ogg"/></ComboBox></Grid>
                        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="MP3-Bitrate" Classes="setting-title"/><ComboBox Grid.Column="1" Width="170" SelectedIndex="{Binding ConverterDefaultBitrateIndex, Mode=TwoWay}"><ComboBoxItem Content="128 kbit/s"/><ComboBoxItem Content="192 kbit/s"/><ComboBoxItem Content="256 kbit/s"/><ComboBoxItem Content="320 kbit/s"/></ComboBox></Grid>
                        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Variable Bitrate (VBR)" Classes="setting-title"/><ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsChecked="{Binding ConverterDefaultVbr, Mode=TwoWay}"/></Grid>
                        <StackPanel Spacing="5"><TextBlock Text="Audio-CD: Zielordner fürs Rippen" Classes="setting-title"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="6"><TextBox x:Name="CdRipFolderBox" Text="{Binding CdRipTargetPath, Mode=TwoWay}" PlaceholderText="Musikordner des Benutzers"/><Button Grid.Column="1" Click="OnChooseCdRipFolderClick" Content="Wählen …"/></Grid><TextBlock Text="{Binding CdRipTargetHint}" Classes="setting-note no-translate"/></StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="LyrionSection" Classes="section"><StackPanel Spacing="16"><TextBlock Text="Lyrion Media Server" Classes="group-caption"/><TextBlock Text="Durchsuche deine Lyrion-Bibliothek und spiele Alben direkt in FerrumPlay ab." Classes="setting-note"/><StackPanel Spacing="5"><TextBlock Text="Serveradresse" Classes="setting-title"/><TextBox Text="{Binding LyrionServerUrl, Mode=TwoWay}" PlaceholderText="http://server:9000 oder https://music.example.lan"/></StackPanel><!-- Ausgeblendet: der Client-Name hat keine Wirkung. Sein einziger Leser ist FindPlayerAsync, und das ruft niemand auf. Ein Eingabefeld dieses Namens laesst erwarten, dass FerrumPlay sich beim Server als Player anmeldet - das tut es nicht. Siehe Audits/LYRION_MEDIA_SERVER.md, Abschnitt Player-Anbindung. --><StackPanel Spacing="5" IsVisible="False"><TextBlock Text="Client-Name" Classes="setting-title"/><TextBox Text="{Binding LyrionClientName, Mode=TwoWay}" PlaceholderText="FerrumPlay"/><TextBlock Text="FerrumPlay spielt die gewählten Titel direkt über den Server ab; ein zusätzlicher Lyrion-Client ist nicht erforderlich." Classes="setting-note"/></StackPanel><StackPanel Spacing="5"><TextBlock Text="Favoriten-Abgleich: Zielordner" Classes="setting-title"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="6"><TextBox x:Name="LyrionSyncFolderBox" Text="{Binding LyrionSyncTargetPath, Mode=TwoWay}" PlaceholderText="Noch kein Ordner gewählt"/><Button Grid.Column="1" Click="OnChooseLyrionSyncFolderClick" Content="Wählen …"/></Grid><TextBlock Text="Der Knopf in der Lyrion-Ansicht gleicht die als Favorit gemerkten Alben in diesen Ordner ab." Classes="setting-note"/></StackPanel></StackPanel></Border>

                <Border x:Name="DiagnosticsSection" Classes="section">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Fehlersuche" Classes="group-caption"/>
                        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="3"><TextBlock Text="Diagnoseprotokoll" Classes="setting-title"/><TextBlock Text="Schreibt ausführliche Zeilen zum Ablauf nach ferrumplay.log. Nur zur Fehlersuche einschalten: im Normalbetrieb wächst die Datei bei jedem Schritt weiter." Classes="setting-note" TextWrapping="Wrap"/></StackPanel><ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsChecked="{Binding EnableDiagnosticLogging, Mode=TwoWay}"/></Grid>
                        <StackPanel Spacing="5">
                            <TextBlock Text="Ordner für Protokolle und Einstellungen" Classes="setting-title"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <TextBlock Text="{Binding DiagnosticLogFolder}" Classes="setting-note no-translate" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Click="OnOpenLogFolderClick" Content="Öffnen"/>
                            </Grid>
                            <!-- Der Hinweis gehoert neben den Schalter: sonst laesst ihn jemand
                                 eingeschaltet, weil er einen Absturz sonst nicht wiederfindet. -->
                            <TextBlock Text="Ausnahmen stehen immer in errors.log, auch bei ausgeschaltetem Protokoll. Der Startparameter --debug schaltet das Protokoll für einen einzelnen Lauf ein." Classes="setting-note" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="TechnologySection" Classes="section">
                    <StackPanel Spacing="14"><StackPanel Spacing="2"><TextBlock Text="Technologie" Classes="group-caption"/><TextBlock Text="FerrumPlay baut auf diesen Projekten auf. Die Schaltflächen öffnen Projektseite und Lizenztext im Browser." Classes="setting-note"/><TextBlock Text="Die Angaben zu Audio-CDs kommen von MusicBrainz und sind gemeinfrei (CC0). Die Titelbilder der Cover Art Archive sind es nicht: sie gehören ihren jeweiligen Rechteinhabern und werden nur angezeigt." Classes="setting-note" TextWrapping="Wrap"/></StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Zusätzliche Werkzeuge" Classes="setting-title"/>
                            <Grid ColumnDefinitions="150,*" ColumnSpacing="12">
                                <TextBlock Text="libmpv" Foreground="{DynamicResource FP.Text.Muted}"/>
                                <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{Binding AudioBackendText}"/><TextBlock Text="Übernimmt die Tonausgabe für Dateien, Audio-CDs und Lyrion-Streams." Classes="setting-note"/></StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="150,*" ColumnSpacing="12">
                                <TextBlock Text="FFmpeg" Foreground="{DynamicResource FP.Text.Muted}"/>
                                <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{Binding FfmpegText}"/><TextBlock Text="Wird für die integrierte Audio-Konvertierung verwendet." Classes="setting-note"/></StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="150,*" ColumnSpacing="12">
                                <TextBlock Text="cdparanoia" Foreground="{DynamicResource FP.Text.Muted}"/>
                                <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{Binding CdParanoiaText}"/><TextBlock Text="Wird benötigt, um Audio-CDs als Dateien auszulesen." Classes="setting-note"/></StackPanel>
                            </Grid>
                        </StackPanel>
                        <UniformGrid Columns="2">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" Margin="0,0,12,6"><StackPanel><TextBlock Text="FerrumPlay" FontWeight="SemiBold"/><TextBlock Text="Diese Anwendung" Classes="muted"/></StackPanel><Button Grid.Column="1" Classes="ghost" Padding="8,5" Tag="https://github.com/Bitpainter75/FerrumPlay" Click="OnLicenseLinkClick"><icons:SvgIcon Source="avares://FerrumPlay/Assets/Icons/outline/info-circle.svg" Width="13" Height="13"/></Button><Button Grid.Column="2" Classes="ghost" Padding="8,5" Tag="https://www.gnu.org/licenses/gpl-3.0.html" Click="OnLicenseLinkClick">GPL-3.0</Button></Grid>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" Margin="0,0,12,6"><StackPanel><TextBlock Text=".NET 10" FontWeight="SemiBold"/><TextBlock Text="Laufzeitumgebung" Classes="muted"/></StackPanel><Button Grid.Column="1" Classes="ghost" Padding="8,5" Tag="https://github.com/dotnet/runtime" Click="OnLicenseLinkClick"><icons:SvgIcon Source="avares://FerrumPlay/Assets/Icons/outline/info-circle.svg" Width="13" Height="13"/></Button><Button Grid.Column="2" Classes="ghost" Padding="8,5" Tag="https://github.com/dotnet/runtime/blob/main/LICENSE.TXT" Click="OnLicenseLinkClick">MIT</Button></Grid>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" Margin="0,0,12,6"><StackPanel><TextBlock Text="Avalonia UI" FontWeight="SemiBold"/><TextBlock Text="Oberfläche" Classes="muted"/></StackPanel><Button Grid.Column="1" Classes="ghost" Padding="8,5" Tag="https://github.com/AvaloniaUI/Avalonia" Click="OnLicenseLinkClick"><icons:SvgIcon Source="avares://FerrumPlay/Assets/Icons/outline/info-circle.svg" Width="13" Height="13"/></Button><Button Grid.Column="2" Classes="ghost" Padding="8,5" Tag="https://github.com/AvaloniaUI/Avalonia/blob/master/licence.md" Click="OnLicenseLinkClick">MIT</Button></Grid>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" Margin="0,0,12,6"><StackPanel><TextBlock Text="SkiaSharp" FontWeight="SemiBold"/><TextBlock Text="Bildkodierung" Classes="muted"/></StackPanel><Button Grid.Column="1" Classes="ghost" Padding="8,5" Tag="https://github.com/mono/SkiaSharp" Click="OnLicenseLinkClick"><icons:SvgIcon Source="avares://FerrumPlay/Assets/Icons/outline/info-circle.svg" Width="13" Height="13"/></Button><Button Grid.Column="2" Classes="ghost" Padding="8,5" Tag="https://github.com/mono/SkiaSharp/blob/main/LICENSE.md" Click="OnLicenseLinkClick">MIT</Button></Grid>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" Margin="0,0,12,6"><StackPanel><TextBlock Text="TagLib#" FontWeight="SemiBold"/><TextBlock Text="Audiodatei-Tags" Classes="muted"/></StackPanel><Button Grid.Column="1" Classes="ghost" Padding="8,5" Tag="https://github.com/mono/taglib-sharp" Click="OnLicenseLinkClick"><icons:SvgIcon Source="avares://FerrumPlay/Assets/Icons/outline/info-circle.svg" Width="13" Height="13"/></Button><Button Grid.Column="2" Classes="ghost" Padding="8,5" Tag="https://www.gnu.org/licenses/old-licenses/lgpl-2.1.html" Click="OnLicenseLinkClick">LGPL-2.1</Button></Grid>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" Margin="0,0,12,6"><StackPanel><TextBlock Text="libmpv" FontWeight="SemiBold"/><TextBlock Text="Wiedergabe" Classes="muted"/></StackPanel><Button Grid.Column="1" Classes="ghost" Padding="8,5" Tag="https://mpv.io/" Click="OnLicenseLinkClick"><icons:SvgIcon Source="avares://FerrumPlay/Assets/Icons/outline/info-circle.svg" Width="13" Height="13"/></Button><Button Grid.Column="2" Classes="ghost" Padding="8,5" Tag="https://github.com/mpv-player/mpv/blob/master/Copyright" Click="OnLicenseLinkClick">GPL-2.0+</Button></Grid>
                                                    <!-- Zwei DATENQUELLEN, keine mitgelieferten Bibliotheken. Sie stehen
                                 trotzdem hier, weil die Anwendung sie im Betrieb befragt und weil
                                 sich die Rechtslage der beiden UNTERSCHEIDET: die Angaben sind
                                 gemeinfrei, die Bilder nicht. -->
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" Margin="0,0,12,6"><StackPanel><TextBlock Text="MusicBrainz" FontWeight="SemiBold"/><TextBlock Text="Erkennung von Audio-CDs" Classes="muted"/></StackPanel><Button Grid.Column="1" Classes="ghost" Padding="8,5" Tag="https://musicbrainz.org" Click="OnLicenseLinkClick"><icons:SvgIcon Source="avares://FerrumPlay/Assets/Icons/outline/info-circle.svg" Width="13" Height="13"/></Button><Button Grid.Column="2" Classes="ghost no-translate" Padding="8,5" Tag="https://musicbrainz.org/doc/About/Data_License" Click="OnLicenseLinkClick">CC0</Button></Grid>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" Margin="0,0,12,6"><StackPanel><TextBlock Text="Cover Art Archive" FontWeight="SemiBold"/><TextBlock Text="Titelbilder zu erkannten CDs" Classes="muted"/></StackPanel><Button Grid.Column="1" Classes="ghost" Padding="8,5" Tag="https://coverartarchive.org" Click="OnLicenseLinkClick"><icons:SvgIcon Source="avares://FerrumPlay/Assets/Icons/outline/info-circle.svg" Width="13" Height="13"/></Button><Button Grid.Column="2" Classes="ghost" Padding="8,5" Tag="https://musicbrainz.org/doc/Cover_Art_Archive" Click="OnLicenseLinkClick">Rechteinhaber</Button></Grid>
                        </UniformGrid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

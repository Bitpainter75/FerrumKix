<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FerrumKix</RootNamespace>
    <AssemblyName>FerrumKix</AssemblyName>
    <!-- Die Nummer steht in der Datei VERSION und NUR dort: dasselbe, was packaging/package.sh
         liest und was die Update-Pruefung aus dem Hauptzweig holt. Eine zweite Nummer hier waere
         die naechste, die auseinanderlaeuft - genau das war vor 0.8.1 der Fall.
         "0.8.1-3" ist die Paketkennung mit pkgrel; die .NET-Versionsfelder vertragen nur die
         Zahlengruppen davor, die Paketkennung selbst traegt die InformationalVersion.
         Das Bauskript setzt beide zusaetzlich ueber -p:, und eine Eigenschaft von der Befehlszeile
         gewinnt gegen diese hier. -->
    <FerrumKixRelease>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/VERSION').Trim())</FerrumKixRelease>
    <FerrumKixVersion>$(FerrumKixRelease)</FerrumKixVersion>
    <FerrumKixVersion Condition="$(FerrumKixRelease.Contains('-'))">$(FerrumKixRelease.Substring(0, $(FerrumKixRelease.IndexOf('-'))))</FerrumKixVersion>
    <Version>$(FerrumKixVersion)</Version>
    <AssemblyVersion>$(FerrumKixVersion).0</AssemblyVersion>
    <FileVersion>$(FerrumKixVersion).0</FileVersion>
    <InformationalVersion>$(FerrumKixRelease)</InformationalVersion>
    <Nullable>enable</Nullable>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <EnableNETAnalyzers>False</EnableNETAnalyzers>
    <ApplicationIcon>FerrumKix_Icon.ico</ApplicationIcon>
    <!-- Wie in FerrumPix: ohne diesen Schalter uebersetzen spaete Bindung und verengende
         Umwandlungen stillschweigend, und die Warnungen dazu sind mit abgeschaltet. In VB ist
         das teuer, weil True zur Zahl -1 wird und nicht zu 1. -->
    <OptionStrict>On</OptionStrict>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <!-- Wie in FerrumPix das virtualisierende Raster: der ItemsRepeater baut nur die Kacheln, die
         wirklich im Sichtbereich liegen, und reicht sie beim Rollen weiter. Ohne ihn erzeugt die
         Alben-Uebersicht des Lyrion-Servers jede Kachel der ganzen Bibliothek auf einmal. -->
    <PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="12.0.0" />
    <!-- Die Titelangaben und das eingebettete Titelbild kommen aus den Kennzeichen der Datei.
         TagLibSharp liest ID3v1, ID3v2, Vorbis, APE und MP4 mit einer Schnittstelle und ist rein
         verwaltet; unter LGPL-2.1 und damit mit der GPL vertraeglich. -->
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
</Project>

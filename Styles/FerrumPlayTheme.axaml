<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:FerrumPlay.Controls">

    <Styles.Resources>
        <FontFamily x:Key="FP.Font.Family">Segoe UI, Cantarell, DejaVu Sans, sans-serif</FontFamily>

        <!-- Die leere Spalte im Menue: ein Menueeintrag haelt 24 Punkte fuer den Tastenkuerzel-Text
             frei, auch wenn keiner gesetzt ist. Auf null gesetzt gewinnt jedes Menue diese Breite
             zurueck. Uebernommen aus FerrumPix, wo derselbe Befund gemacht wurde. -->
        <Thickness x:Key="MenuInputGestureTextMargin">0</Thickness>

        <!-- Schriftgroessen. Eine Vergroesserung der ganzen Anwendung ist eine Aenderung an diesen
             neun Zahlen und nicht an jeder AXAML-Datei. -->
        <x:Double x:Key="FP.Font.Label">9</x:Double>
        <x:Double x:Key="FP.Font.Caption">10</x:Double>
        <x:Double x:Key="FP.Font.Small">11</x:Double>
        <x:Double x:Key="FP.Font.Body">12</x:Double>
        <x:Double x:Key="FP.Font.ItemTitle">13</x:Double>
        <x:Double x:Key="FP.Font.Subtitle">14</x:Double>
        <x:Double x:Key="FP.Font.Title">15</x:Double>
        <x:Double x:Key="FP.Font.Heading">18</x:Double>
        <x:Double x:Key="FP.Font.Display">24</x:Double>

        <!-- Symbolzeichen in Fensterknoepfen. Sie sind Grafik, keine Typografie, und duerfen bei
             einer Schriftvergroesserung nicht mitwachsen. -->
        <x:Double x:Key="FP.Glyph.Small">10</x:Double>
        <x:Double x:Key="FP.Glyph.Medium">13</x:Double>
        <x:Double x:Key="FP.Glyph.Large">14</x:Double>
        <x:Double x:Key="FP.Glyph.XLarge">16</x:Double>

        <SolidColorBrush x:Key="FP.Bg.Root" Color="#0B0E11"/>
        <SolidColorBrush x:Key="FP.Bg.Dark" Color="#0E1216"/>
        <SolidColorBrush x:Key="FP.Bg.Panel" Color="#11161B"/>
        <SolidColorBrush x:Key="FP.Bg.Content" Color="#141A20"/>
        <SolidColorBrush x:Key="FP.Bg.Elevated" Color="#192128"/>
        <SolidColorBrush x:Key="FP.Bg.Hover" Color="#1F2830"/>
        <SolidColorBrush x:Key="FP.Bg.Input" Color="#10161B"/>
        <SolidColorBrush x:Key="FP.Bg.Active" Color="#24303A"/>

        <SolidColorBrush x:Key="FP.Accent" Color="#F08A1A"/>
        <SolidColorBrush x:Key="FP.Accent.Light" Color="#FF9D2F"/>
        <SolidColorBrush x:Key="FP.Accent.Dark" Color="#BC6711"/>
        <SolidColorBrush x:Key="FP.Accent.Dim" Color="#2B1606"/>

        <SolidColorBrush x:Key="FP.Text.Primary" Color="#E7ECF0"/>
        <SolidColorBrush x:Key="FP.Text.Secondary" Color="#A6AFB7"/>
        <SolidColorBrush x:Key="FP.Text.Muted" Color="#6C7780"/>
        <SolidColorBrush x:Key="FP.Text.Accent" Color="#F08A1A"/>
        <SolidColorBrush x:Key="FP.Text.Danger" Color="#FF6B6B"/>

        <SolidColorBrush x:Key="FP.Border.Subtle" Color="#182028"/>
        <SolidColorBrush x:Key="FP.Border.Normal" Color="#26313B"/>
        <SolidColorBrush x:Key="FP.Border.Strong" Color="#34414C"/>

        <SolidColorBrush x:Key="FP.Sel.Bg" Color="#24303A"/>
        <SolidColorBrush x:Key="FP.Sel.Hover" Color="#2A3742"/>

        <!-- DIE FUSSLEISTE IST EIN DUNKLES DECK. Sie liegt als eigene, leicht angehobene Flaeche
             unter Cover und Liste, im Ton des Fensters und nicht in der Akzentfarbe. Die Farbe
             steckt nur in dem, was sich bewegt oder eingeschaltet ist: gespielte Strecke,
             Wiedergabeknopf, Lautstaerkebogen, aktive Schalter. Die Leiste ist leicht
             durchscheinend, damit das unscharfe Titelbild dahinter noch ahnbar bleibt. -->
        <SolidColorBrush x:Key="FP.Footer.Bg" Color="#EB0E1317"/>
        <SolidColorBrush x:Key="FP.Footer.Edge" Color="#222C35"/>
        <SolidColorBrush x:Key="FP.Footer.Track" Color="#2A353F"/>
        <!-- Das Symbol im gefuellten Wiedergabeknopf. Wird aus der Akzentfarbe abgeleitet. -->
        <SolidColorBrush x:Key="FP.Footer.OnAccent" Color="#2B1A08"/>

        <!-- Die Zeile des gerade laufenden Titels in der Liste. -->
        <SolidColorBrush x:Key="FP.Row.Playing" Color="#7A4A12"/>
        <SolidColorBrush x:Key="FP.Row.PlayingHover" Color="#8C5616"/>

        <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#192128"/>
        <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#26313B"/>
        <Thickness x:Key="MenuFlyoutPresenterBorderThemeThickness">1</Thickness>
        <Thickness x:Key="MenuFlyoutPresenterThemePadding">6</Thickness>
        <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#192128"/>
        <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#26313B"/>
        <SolidColorBrush x:Key="ComboBoxItemBackground" Color="Transparent"/>
        <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#1F2830"/>
        <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#24303A"/>
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#24303A"/>
        <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#E7ECF0"/>
        <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#E7ECF0"/>
        <SolidColorBrush x:Key="ListBoxItemBackground" Color="Transparent"/>
        <SolidColorBrush x:Key="ListBoxItemBackgroundPointerOver" Color="#1F2830"/>
        <SolidColorBrush x:Key="ListBoxItemBackgroundPressed" Color="#24303A"/>
        <SolidColorBrush x:Key="ListBoxItemBackgroundSelected" Color="#24303A"/>
        <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPointerOver" Color="#2A3742"/>
        <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPressed" Color="#2A3742"/>
        <SolidColorBrush x:Key="ListBoxItemForeground" Color="#E7ECF0"/>
        <SolidColorBrush x:Key="ListBoxItemForegroundSelected" Color="#E7ECF0"/>
        <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#F08A1A"/>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Root}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FP.Font.Family}"/>
        <Setter Property="FontSize" Value="{DynamicResource FP.Font.Body}"/>
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource FP.Font.Body}"/>
    </Style>
    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Secondary}"/>
        <Setter Property="FontSize" Value="{DynamicResource FP.Font.Small}"/>
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Muted}"/>
        <Setter Property="FontSize" Value="{DynamicResource FP.Font.Caption}"/>
    </Style>
    <Style Selector="TextBlock.section-header">
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Muted}"/>
        <Setter Property="FontSize" Value="{DynamicResource FP.Font.Label}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="10,10,10,4"/>
        <Setter Property="LetterSpacing" Value="1.3"/>
    </Style>

    <Style Selector="icons|SvgIcon">
        <Setter Property="IconBrush" Value="{DynamicResource FP.Text.Secondary}"/>
    </Style>

    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Elevated}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="FontSize" Value="{DynamicResource FP.Font.Body}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <!-- Icon-und-Text-Knoepfe packen ihren Inhalt in ein horizontales StackPanel; darin wird der
         kuerzere TextBlock auf die Hoehe des hoeheren Symbols gestreckt und rendert den Text dann
         oben statt in der Mitte. -->
    <Style Selector="Button StackPanel[Orientation=Horizontal] > TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Hover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Strong}"/>
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.8"/>
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.35"/>
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="11,6"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Secondary}"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Elevated}"/>
    </Style>
    <!-- In einem Aufklappmenue braucht derselbe Knopf eine andere Farbe: der FlyoutPresenter ist
         selbst FP.Bg.Elevated, die Regel darueber malte also genau den Untergrund. -->
    <Style Selector="FlyoutPresenter Button.ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Hover}"/>
    </Style>

    <Style Selector="Button.icon-btn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Secondary}"/>
    </Style>
    <Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Elevated}"/>
    </Style>
    <Style Selector="Button.icon-btn.active icons|SvgIcon">
        <Setter Property="IconBrush" Value="{DynamicResource FP.Accent}"/>
    </Style>

    <!-- Ein Farbfeld der Akzentauswahl. Der RAHMEN und nicht die Fuellung zeigt die Wahl an: die
         Fuellung IST die Farbe und kann sie deshalb nicht zugleich hervorheben. -->
    <Style Selector="Button.swatch">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Strong}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.swatch:pointerover /template/ ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Text.Primary}"/>
    </Style>
    <Style Selector="Button.swatch.active">
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Text.Primary}"/>
        <Setter Property="BorderThickness" Value="3"/>
    </Style>

    <!-- Eine Stufe der Schriftgroesse. Alle Knoepfe sind gleich gross, damit die Reihe ruhig
         bleibt; nur die Probe darin waechst. -->
    <Style Selector="Button.font-step">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Elevated}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.font-step:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Hover}"/>
    </Style>
    <Style Selector="Button.font-step.active">
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Button.font-step.active TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FP.Accent}"/>
    </Style>

    <!-- Die drei Fensterknoepfe. Ihre Groesse haengt an der Hoehe der Fensterleiste: sie stehen
         darueber und muessen hineinpassen. -->
    <Style Selector="Button.wnd-btn, Button.wnd-close">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Panel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Secondary}"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.wnd-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Hover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Strong}"/>
    </Style>
    <Style Selector="Button.wnd-close:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#3A1511"/>
        <Setter Property="BorderBrush" Value="#8D332A"/>
        <Setter Property="TextElement.Foreground" Value="White"/>
    </Style>

    <!-- Der Reiter ueber der Wiedergabeliste. Der aktive traegt einen Strich in Akzentfarbe unter
         sich; die Farbe des Textes wechselt mit. -->
    <Style Selector="Button.playlist-tab">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="4,6"/>
        <Setter Property="Margin" Value="0,0,18,0"/>
        <Setter Property="FontSize" Value="{DynamicResource FP.Font.Subtitle}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Muted}"/>
    </Style>
    <Style Selector="Button.playlist-tab:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource FP.Text.Secondary}"/>
    </Style>
    <Style Selector="Button.playlist-tab.active">
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Accent}"/>
    </Style>
    <Style Selector="Button.playlist-tab.active:pointerover /template/ ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource FP.Accent}"/>
    </Style>

    <!-- Die Knoepfe der Fussleiste. Hell auf dunkel, ohne eigenen Hintergrund: die Leiste soll
         eine ruhige Flaeche bleiben und kein Knopfteppich werden. Erst unter dem Zeiger bekommt
         ein Knopf eine Scheibe.
         DIE REIHENFOLGE ZAEHLT: bei gleicher Trefferlage gewinnt die spaetere Regel. Die Regel
         fuer den Wiedergabeknopf steht deshalb HINTER der Zeigerregel, sonst wuerde sein Symbol
         unter dem Zeiger hell statt dunkel. -->
    <Style Selector="Button.transport">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="CornerRadius" Value="20"/>
    </Style>
    <Style Selector="Button.transport icons|SvgIcon">
        <Setter Property="IconBrush" Value="{DynamicResource FP.Text.Secondary}"/>
    </Style>
    <Style Selector="Button.transport:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Hover}"/>
    </Style>
    <Style Selector="Button.transport:pointerover icons|SvgIcon">
        <Setter Property="IconBrush" Value="{DynamicResource FP.Text.Primary}"/>
    </Style>

    <!-- Wiedergabe und Pause: der einzige gefuellte Knopf, in der Akzentfarbe. Er ist der, den
         man im Vorbeigehen trifft, und darf deshalb auffallen. -->
    <Style Selector="Button.transport.primary">
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Margin" Value="6,0"/>
        <Setter Property="Background" Value="{DynamicResource FP.Accent}"/>
    </Style>
    <Style Selector="Button.transport.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Accent.Light}"/>
    </Style>
    <Style Selector="Button.transport.primary icons|SvgIcon">
        <Setter Property="IconBrush" Value="{DynamicResource FP.Footer.OnAccent}"/>
    </Style>

    <!-- Die kleinen Schalter links: Zufall, Wiederholen, dazu der Stummschalter rechts.
         Ausgeschaltet stehen sie gedaempft da, eingeschaltet in der Akzentfarbe. -->
    <Style Selector="Button.transport-toggle">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.transport-toggle icons|SvgIcon">
        <Setter Property="IconBrush" Value="{DynamicResource FP.Text.Muted}"/>
    </Style>
    <Style Selector="Button.transport-toggle:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Hover}"/>
    </Style>
    <Style Selector="Button.transport-toggle:pointerover icons|SvgIcon">
        <Setter Property="IconBrush" Value="{DynamicResource FP.Text.Secondary}"/>
    </Style>
    <Style Selector="Button.transport-toggle.active icons|SvgIcon">
        <Setter Property="IconBrush" Value="{DynamicResource FP.Accent}"/>
    </Style>

    <!-- Der Drehknopf der Lautstaerke. Dunkler Knopf mit grauem Ring wie im Zeichen der
         Anwendung; stumm geschaltet verliert der Bogen seine Farbe, der Wert bleibt aber
         stehen - so sieht man, wohin es nach dem Einschalten zurueckgeht. -->
    <Style Selector="icons|VolumeKnob">
        <Setter Property="TrackBrush" Value="{DynamicResource FP.Footer.Track}"/>
        <Setter Property="ValueBrush" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="KnobBrush" Value="{DynamicResource FP.Bg.Elevated}"/>
        <Setter Property="RimBrush" Value="{DynamicResource FP.Text.Muted}"/>
    </Style>
    <Style Selector="icons|VolumeKnob:pointerover">
        <Setter Property="RimBrush" Value="{DynamicResource FP.Text.Secondary}"/>
    </Style>
    <Style Selector="icons|VolumeKnob:focus-visible">
        <Setter Property="RimBrush" Value="{DynamicResource FP.Text.Primary}"/>
    </Style>
    <Style Selector="icons|VolumeKnob.muted">
        <Setter Property="ValueBrush" Value="{DynamicResource FP.Text.Muted}"/>
    </Style>

    <Style Selector="TextBlock.footer-time">
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Secondary}"/>
        <Setter Property="FontSize" Value="{DynamicResource FP.Font.Small}"/>
    </Style>
    <Style Selector="TextBlock.footer-time.total">
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Muted}"/>
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Input}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="CaretBrush" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource FP.Accent.Dim}"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Accent}"/>
    </Style>
    <!-- Das Suchfeld der Fusszeile sitzt in einer eigenen Leiste und braucht dort keinen Rahmen:
         die Leiste ist schon abgesetzt, ein zweiter Rahmen darin ist Rauschen.
         Die Fluent-Vorlage legt Text und Platzhalter OBEN in ihr Feld, das mindestens 32 Punkte
         hoch ist - ohne die senkrechte Mitte stand der Platzhalter hoeher als das Lupensymbol
         daneben. Der linke Innenrand ruckt ihn etwas von der Lupe ab. -->
    <Style Selector="TextBox.quiet">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,0,0,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.quiet /template/ TextBlock#PART_Placeholder">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.quiet:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.quiet:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="Slider">
        <Setter Property="Foreground" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="Background" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="Height" Value="20"/>
    </Style>
    <Style Selector="Slider /template/ Thumb">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Background" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Bg.Root}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="7"/>
    </Style>
    <Style Selector="Slider /template/ Thumb /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Bg.Root}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="7"/>
    </Style>

    <!-- Der Schieberegler der Einstellungen, wie in FerrumPix. Die Hoehe ist fast ganz
         Klickflaeche: die Spur selbst ist nur 4 Punkte stark. -->
    <Style Selector="icons|RoundSlider">
        <Setter Property="TrackBrush" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="FillBrush" Value="{DynamicResource FP.Accent}"/>
        <Setter Property="ThumbBorderBrush" Value="{DynamicResource FP.Bg.Root}"/>
        <Setter Property="Height" Value="36"/>
    </Style>

    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="13"/>
    </Style>
    <Style Selector="ScrollBar:horizontal">
        <Setter Property="Height" Value="13"/>
    </Style>
    <Style Selector="ScrollBar:vertical /template/ Thumb">
        <Setter Property="MinWidth" Value="10"/>
    </Style>

    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <!-- Die Zeilen der Wiedergabeliste malen ihren Hintergrund SELBST (siehe TrackRowView): der
         laufende Titel, die Auswahl und der Zeiger ueberlagern sich, und drei Zustaende in der
         Vorlage eines ListBoxItem auseinanderzuhalten geht nur ueber eine Kette von Regeln, die
         bei jeder Aenderung neu zu ordnen waere. Deshalb ist das Element hier durchsichtig. -->
    <Style Selector="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBoxItem:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="Border.toolbar">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Dark}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style Selector="Border.sidebar">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Panel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
    </Style>
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Content}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14"/>
    </Style>
    <Style Selector="Border.section">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Content}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Hover}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Strong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4,14,4"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="FontSize" Value="{DynamicResource FP.Font.Small}"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MaxWidth" Value="440"/>
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource FP.Font.Body}"/>
        <Setter Property="Padding" Value="8,5"/>
    </Style>
    <Style Selector="MenuItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Hover}"/>
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource FP.Bg.Input}"/>
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FP.Border.Normal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>

    <Style Selector="ToggleSwitch">
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
        <Setter Property="MinWidth" Value="0"/>
    </Style>
    <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
        <Setter Property="Background" Value="{DynamicResource FP.Accent}"/>
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource FP.Text.Primary}"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>

</Styles>
